# Heavy / sensitive things that must never reach the build context.

.git/
.github/
.venv/
venv/
node_modules/
dist/
build/
.pio/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Secrets / persistent state — operators mount these as volumes.
# Day-2 D2-D-G2 (audit-2026-04-29): exhaustive SQLite exclusion. The
# dev daemon writes phantom.db at whatever cwd `init_db` runs from, so
# the repo accumulates copies under src/backend/, src/frontend/,
# src/backend/db/ over time. Each is potentially seeded with operator
# data (sealed memories, behavioural model, audit-log rows) and MUST
# NOT reach the image. Glob covers future locations.
.env
.env.local
src/backend/chroma_data/
**/phantom.db
**/phantom.db-journal
**/phantom.db-shm
**/phantom.db-wal
src/backend/voice/models/

# Already built tooling — heavy and re-built inside the frontend stage.
src/frontend/dist/
src/frontend/node_modules/
