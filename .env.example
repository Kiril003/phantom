# PHANTOM OS — operator environment template. Copy to .env and fill.
# .env is gitignored — never commit real secrets.

# ── Authentication ──────────────────────────────────────────────────────────
# JWT signing secret. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Audit-2026-04-28 F-14 — rotate quarterly; revocation list lands in 17b.
JWT_SECRET_KEY=

# ── AI providers ────────────────────────────────────────────────────────────
# Primary: Google Gemini. Get a key at https://aistudio.google.com/apikey.
AI_GEMINI_API_KEY=

# Fallback: local Ollama (skip if you don't run a local Ollama).
# AI_OLLAMA_HOST=http://host.docker.internal:11434

# ── Logging ────────────────────────────────────────────────────────────────
PHANTOM_LOG_LEVEL=INFO

# ── Port mapping ────────────────────────────────────────────────────────────
# Maps to container's 8000.
PHANTOM_PORT=8000
