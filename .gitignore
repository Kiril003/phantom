# ChromaDB per-collection data dirs (UUID-named) AND the chroma.sqlite3
# metadata DB. Day-3 D3-C-8 (audit-2026-04-30): chroma.sqlite3 was
# previously tracked "for the schema" — but the schema is created by
# the persistent client on first instantiation (`init_chroma_eager`
# at lifespan), so checking it in only meant operator data (collection
# metadata, sealed embeddings) ended up in the commit graph. The
# audit's recommendation was to untrack and rely on lifespan
# bootstrap; that's what the gitignore now enforces.
src/backend/chroma_data/chroma.sqlite3
src/backend/chroma_data/chroma.sqlite3-journal
src/backend/chroma_data/chroma.sqlite3-shm
src/backend/chroma_data/chroma.sqlite3-wal
src/backend/chroma_data/*/
# Day-4 Wave-2 audit fix: pytest sometimes creates ./chroma_data at the
# repo root (CWD-dependent). Never commit operator data anywhere in the
# tree.
chroma_data/
**/chroma_data/

# Voice models: large pretrained blobs (Piper UA ~73 MB, Vosk UK ~400 MB)
# stay out of git; fetched via setup / manual download. Silero VAD
# (~2.3 MB) is small enough to commit for a self-contained repo (Phase 11b).
src/backend/voice/models/piper/
src/backend/voice/models/vosk-model-uk-v3/
src/backend/voice/models/vosk-model-uk-v3.zip

# Phase 15: HuggingFace Whisper checkpoints (large) and converted ONNX/QNN
# bundles. Both fetched/built locally via scripts/convert_whisper_to_qnn.py.
src/backend/voice/models/whisper-turbo-hf/
src/backend/voice/models/whisper-small-qnn/
src/backend/voice/models/whisper-small-hf/
src/backend/voice/models/whisper-turbo-qnn/

# Phase 15b: MMS-1B per-language bundles (one ~280 MB .bin per lang) and
# raw AI Hub compile assets. All built locally via
# scripts/aihub_compile_mms.py / aihub_compile_whisper_turbo.py.
src/backend/voice/models/mms-*-qnn/
aihub_assets/
aihub_assets_*/
src/backend/test_script/
src/frontend/chroma_data/

# F0.2 — root scratch/fix scripts must never return (repo-hygiene law)
/scratch.py
/fix_fasttrack.py
/refactor_imports.py
/*_flake8.log
/*_vulture.log

# Ruflo / claude-flow swarm artifacts (Day-4 onwards)
.claude/
.claude-flow/
.swarm/
.swarm-temp/
.ruflo-cache/
.swarm.backup-*/

# Day-4 V-2 (ADR-DSH-002) — dev-mode data root for chroma / sqlite /
# voice_models / workspace caches. Packaged builds resolve under
# platformdirs.user_data_dir, which lives outside the repo by design.
.phantom-data/

# G0.1 (PHANTOM_FORGE_PLAN Part II): graphify code graph is a regenerable
# ~50MB local artifact (`graphify update .`), not a commit-worthy blob.
# Same precedent as phantom-companion's .gitignore.
graphify-out/
