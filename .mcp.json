{
  "mcpServers": {
    "google-stitch": {
      "command": "npx",
      "args": [
        "-y",
        "@_davideast/stitch-mcp",
        "proxy"
      ],
      "env": {
        "STITCH_API_KEY": "AQ.Ab8RN6JwbvOx1DTdCsIeEXoMOJXm4hMMcVw-DIJRlYU-4mKVyA",
        "GOOGLE_API_KEY": "AQ.Ab8RN6JwbvOx1DTdCsIeEXoMOJXm4hMMcVw-DIJRlYU-4mKVyA"
      },
      "autoStart": true
    },
    "claude-flow": {
      "command": "npx",
      "args": [
        "-y",
        "@claude-flow/cli@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": false
    }
  }
}