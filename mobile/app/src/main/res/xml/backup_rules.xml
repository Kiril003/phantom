<?xml version="1.0" encoding="utf-8"?>
<!-- Block auto-backup. Device JWT, pairing keys, and any future Vault
     ciphertext live in EncryptedSharedPreferences; auto-backup would
     defeat the Keystore-binding by lifting wrapped blobs to Google. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
