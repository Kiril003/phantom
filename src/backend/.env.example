# PHANTOM OS backend env template. Copy to .env and edit.
# All keys below map to fields on PhantomConfig (see config.py). Missing keys
# fall back to in-code defaults; DB overrides (SettingsPanel / PUT /settings)
# win over both.

# ── Required ─────────────────────────────────────────────────────────────
# Must be a random string of 32+ chars. Without it, JWT won't sign.
JWT_SECRET_KEY=

# ── Serial bridge ────────────────────────────────────────────────────────
# false on dev machines without ESP32; true on Radxa Dragon Q6A target.
PHANTOM_SERIAL_ENABLED=false

# ── Logging ──────────────────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR

# ── AI ───────────────────────────────────────────────────────────────────
# Primary provider. Accepts AI_PROVIDER (short) or AI_PRIMARY_PROVIDER.
AI_PROVIDER=ollama        # gemini | ollama
AI_FALLBACK_PROVIDER=none # gemini | ollama | none
AI_TIMEOUT_S=120          # per-request timeout; raise for slow local models

# Gemini 2.0 Flash (cloud). Leave empty to disable.
AI_GEMINI_MODEL=gemini-2.0-flash
AI_GEMINI_API_KEY=

# Ollama (local). Model must exist: `ollama pull <name>` first.
AI_OLLAMA_MODEL=llama3.2:3b      # e.g. llama3.2:3b, phi3:mini, llama3.1:8b
AI_OLLAMA_HOST=http://localhost:11434
AI_OLLAMA_NUM_CTX=8192

# Generation tuning (shared across providers).
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_TOP_P=0.9
AI_RESPONSE_LANGUAGE=auto        # auto | uk | en | ru
AI_STREAMING=true

# Initiative (autonomous AI nudges).
AI_INITIATIVE_ENABLED=true
AI_INITIATIVE_COOLDOWN_S=300

# ── Voice / STT ──────────────────────────────────────────────────────────
VOICE_STT_MODE=hybrid            # hybrid | vosk | whisper
VOICE_STT_LANGUAGE=uk            # uk | en | auto

# ── Voice / TTS ──────────────────────────────────────────────────────────
VOICE_TTS_ENABLED=true
VOICE_TTS_VOICE=Марина
VOICE_WAKE_WORDS=фантом
