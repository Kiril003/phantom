{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aegis-film",
  "version": "0.1.0",
  "identifier": "os.phantom.aegis.film",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "film",
        "title": "AEGIS Film",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "breath",
        "title": "Breath Line",
        "url": "breath.html",
        "width": 900,
        "height": 600,
        "center": true,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ws://127.0.0.1:8000 http://127.0.0.1:8000 ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
