{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "PHANTOM OS",
  "version": "0.20.0",
  "identifier": "ai.phantom.os",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PHANTOM OS",
        "width": 1024,
        "height": 600,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "url": "splash.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 ws://127.0.0.1:8000; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "msi", "nsis"],
    "category": "Productivity",
    "shortDescription": "PHANTOM OS — alive AI assistant on custom hardware.",
    "longDescription": "Local-first AI companion with multi-agent orchestration, vector memory, and an autonomous behaviour core. The Tauri shell hosts the React frontend; a PyInstaller sidecar runs the FastAPI backend bound to 127.0.0.1.",
    "publisher": "PHANTOM OS",
    "homepage": "https://github.com/anthropics/phantom-os",
    "copyright": "Copyright (c) 2026 PHANTOM OS contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/phantom-backend"],
    "resources": [],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
